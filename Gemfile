source "https://rubygems.org"

# Built by GitHub Actions (.github/workflows/pages.yml), not the classic
# github-pages gem, so any Jekyll version and plugin can be used.
gem "jekyll", "~> 4.4"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
  gem "jekyll-remote-theme"
  gem "jekyll-redirect-from"
  gem "jekyll-compose", group: :development
end

# Not in the default gem set since Ruby 3.4 / 3.0.
gem "webrick"
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
